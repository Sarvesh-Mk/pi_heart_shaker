		(uuid "0dd1c747-664d-4540-b8aa-82a356e9cc56")
	)
	(text "/boot/firmware/config.txt:\n  dtoverlay=max98357a\n  dtoverlay=gpio-shutdown,gpio_pin=3\nButtons use the Pi's internal pull-ups (gpiozero Button default)."
		(exclude_from_sim no)
		(at 152.4 152.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5bc0c612-b19c-4c07-af88-2988343fd037")
	)
	(text "J2 pin order matches the breakout silkscreen:\n1 LRC, 2 BCLK, 3 DIN, 4 GAIN, 5 SD, 6 GND, 7 Vin\nSD left open: breakout's pull-up selects (L+R)/2 mono."
		(exclude_from_sim no)
		(at 152.4 45.72 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "699296dd-31cc-4d23-aa09-f6fe18ef2aab")
	)
	(text "GPIO map:\n  pin 5  GPIO3  BTN_SHUTDOWN (also wakes Pi from halt)\n  pin 11 GPIO17 BTN_NEXT\n  pin 12 GPIO18 I2S_BCLK\n  pin 35 GPIO19 I2S_LRCLK\n  pin 40 GPIO21 I2S_DIN\n  pins 2,4 +5V   (amp Vin)"
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "d0b06a41-815f-4e82-bf77-7bbc1df2f858")
	)
