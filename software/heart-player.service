[Unit]
Description=Pi Heart-Sound Shaker player
After=sound.target
Wants=sound.target

[Service]
Type=simple
User=__USER__
Group=audio
SupplementaryGroups=gpio
WorkingDirectory=/opt/heart-shaker
ExecStart=/usr/bin/python3 /opt/heart-shaker/heart_player.py --sounds /opt/heart-shaker/sounds
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
